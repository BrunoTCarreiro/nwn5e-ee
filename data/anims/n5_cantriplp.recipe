# nwn5e animation recipe (core/anim_packs.cpp builds it at startup, for every body) - the loop of the short cantrip
# cast (#150): castoutlp, the pose held after castout while a cast's time runs, on the same combat-ready legs as
# n5_cantrip (1hreadyr, looping), so the legs don't change when the engine goes from castout to castoutlp.
# core/anim_cast_clip swaps it in with n5_cantrip. Tune it with n5_cantrip in the Animation Recipe Bench.
name = n5_cantriplp
base = castoutlp
mix =
amount = 0
speed = 1
start = 0
end = 0
crouch = 0
lean = 0
legs = 1hreadyr

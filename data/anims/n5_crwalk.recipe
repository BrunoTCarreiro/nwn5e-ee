# nwn5e animation recipe (core/anim_packs.cpp builds it at startup, for every body) -
# the crouch walk a hiding creature uses (stance_look.cpp): the walk, the hips 40 cm down -
# the legs solved to keep its footfalls - leaning 70 degrees forward (a hip hinge).
# Owner, 2026-10-25: "go, use stealth mode as the trigger"; 0.4 m / 70 degrees are the
# owner's own tuning in the bench (n5_lowcrwalk / n5_lowcridle). Tune it in the Animation
# Recipe Bench (tools/recipe_bench); a copy saved there overrides this one.
name = n5_crwalk
base = walk
mix = 
amount = 0
speed = 1
start = 0
end = 0
crouch = 0.4
lean = 70

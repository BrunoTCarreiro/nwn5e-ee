#MAXMODEL ASCII
# nwn5e (#144): a test marker for an effect that follows a body part - the owner's symbol n5t_mark05 on
# three crossed two-sided squares, 0.24 m.
newmodel n5v_nodetest_r
setsupermodel n5v_nodetest_r NULL
classification effect
setanimationscale 1
beginmodelgeom n5v_nodetest_r
node dummy n5v_nodetest_r
  parent NULL
endnode
node trimesh n5v_nodetest_r_mark
  parent n5v_nodetest_r
  ambient 1 1 1
  diffuse 1 1 1
  specular 0 0 0
  shininess 1
  bitmap n5t_mark05
  render 1
  shadow 0
  beaming 0
  inheritcolor 0
  alpha 1
  transparencyhint 1
  selfillumcolor 1 1 1
  tilefade 0
  rotatetexture 0
  position 0 0 0
  orientation 0 0 0 0
  verts 12
    -0.1200 -0.1200 0.0000
    0.1200 -0.1200 0.0000
    0.1200 0.1200 0.0000
    -0.1200 0.1200 0.0000
    -0.1200 0.0000 -0.1200
    0.1200 0.0000 -0.1200
    0.1200 0.0000 0.1200
    -0.1200 0.0000 0.1200
    0.0000 -0.1200 -0.1200
    0.0000 0.1200 -0.1200
    0.0000 0.1200 0.1200
    0.0000 -0.1200 0.1200
  tverts 12
    0.0000 0.0000 0
    1.0000 0.0000 0
    1.0000 1.0000 0
    0.0000 1.0000 0
    0.0000 0.0000 0
    1.0000 0.0000 0
    1.0000 1.0000 0
    0.0000 1.0000 0
    0.0000 0.0000 0
    1.0000 0.0000 0
    1.0000 1.0000 0
    0.0000 1.0000 0
  faces 12
    0 1 2 1 0 1 2 0
    0 2 3 1 0 2 3 0
    0 2 1 1 0 2 1 0
    0 3 2 1 0 3 2 0
    4 5 6 1 4 5 6 0
    4 6 7 1 4 6 7 0
    4 6 5 1 4 6 5 0
    4 7 6 1 4 7 6 0
    8 9 10 1 8 9 10 0
    8 10 11 1 8 10 11 0
    8 10 9 1 8 10 9 0
    8 11 10 1 8 11 10 0
endnode
endmodelgeom n5v_nodetest_r

newanim impact n5v_nodetest_r
  length 0.1
  transtime 0.25
  animroot n5v_nodetest_r
node dummy n5v_nodetest_r
  parent NULL
endnode
doneanim impact n5v_nodetest_r

newanim duration n5v_nodetest_r
  length 1
  transtime 0.25
  animroot n5v_nodetest_r
node dummy n5v_nodetest_r
  parent NULL
endnode
doneanim duration n5v_nodetest_r

newanim cessation n5v_nodetest_r
  length 0.3
  transtime 0.05
  animroot n5v_nodetest_r
node dummy n5v_nodetest_r
  parent NULL
endnode
node trimesh n5v_nodetest_r_mark
  parent n5v_nodetest_r
  alphakey 2
    0 1
    0.3 0
endnode
doneanim cessation n5v_nodetest_r

donemodel n5v_nodetest_r

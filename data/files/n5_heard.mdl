#MAXMODEL ASCII
# nwn5e (tools/data/stealth_marker.py): the stealth marker - a camera-facing
# sprite over a creature that has noticed a hiding player character: the
# game's own isk_listen icon (by name, from the player's install).
newmodel n5_heard
setsupermodel n5_heard NULL
classification effect
setanimationscale 1
beginmodelgeom n5_heard
node dummy n5_heard
  parent NULL
endnode
node emitter n5_heard_icon
  parent n5_heard
  p2p 0
  p2p_sel 1
  affectedByWind 0
  m_isTinted 0
  bounce 0
  random 0
  inherit 1
  inheritvel 0
  inherit_local 0
  splat 0
  inherit_part 0
  renderorder 0
  spawntype 0
  update Single
  render Normal
  blend Normal
  texture isk_listen
  xgrid 1
  ygrid 1
  loop 0
  deadspace 0
  twosidedtex 0
  blastRadius 0
  blastLength 0
  position 0 0 0.45
  orientation 0 0 0 0
  colorStart 1 1 1
  colorEnd 1 1 1
  alphaStart 1
  alphaEnd 1
  sizeStart 0
  sizeEnd 0
  sizeStart_y 0
  sizeEnd_y 0
  frameStart 0
  frameEnd 0
  birthrate 1
  lifeExp -1
  mass 0
  spread 0
  particleRot 0
  velocity 0
  randvel 0
  fps 0
  xsize 0
  ysize 0
  bounce_co 0
  blurlength 10
  lightningDelay 0
  lightningRadius 0
  lightningScale 0
  p2p_bezier2 0
  p2p_bezier3 0
  combinetime 0
  drag 0
  grav 0
  threshold 0
endnode
endmodelgeom n5_heard

newanim impact n5_heard
  length 0.25
  transtime 0.25
  animroot n5_heard
node dummy n5_heard
  parent NULL
endnode
node emitter n5_heard_icon
  parent n5_heard
  sizeStartkey 3
    0 0
    0.15 0.5175
    0.25 0.45
  sizeEndkey 3
    0 0
    0.15 0.5175
    0.25 0.45
endnode
doneanim impact n5_heard

newanim duration n5_heard
  length 1
  transtime 0.25
  animroot n5_heard
node dummy n5_heard
  parent NULL
endnode
node emitter n5_heard_icon
  parent n5_heard
  sizeStartkey 2
    0 0.45
    1 0.45
  sizeEndkey 2
    0 0.45
    1 0.45
endnode
doneanim duration n5_heard

newanim cessation n5_heard
  length 0.2
  transtime 0.25
  animroot n5_heard
node dummy n5_heard
  parent NULL
endnode
node emitter n5_heard_icon
  parent n5_heard
  sizeStartkey 2
    0 0.45
    0.2 0
  sizeEndkey 2
    0 0.45
    0.2 0
endnode
doneanim cessation n5_heard

donemodel n5_heard

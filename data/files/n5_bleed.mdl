#MAXMODEL ASCII
# nwn5e (tools/data/bleed_vfx.py): low hit points - a character bleeding;
# the game's textures by name.
newmodel n5_bleed
setsupermodel n5_bleed NULL
classification effect
setanimationscale 1
beginmodelgeom n5_bleed
node dummy n5_bleed
  parent NULL
endnode
node emitter n5_bleed_puddle
  parent n5_bleed
  p2p 0
  p2p_sel 1
  affectedByWind 0
  m_isTinted 0
  bounce 1
  random 1
  inherit 0
  inheritvel 0
  inherit_local 0
  splat 1
  inherit_part 0
  renderorder 0
  spawntype 0
  update Fountain
  render Normal
  blend Normal
  texture blood
  xgrid 2
  ygrid 2
  loop 0
  deadspace 0
  twosidedtex 0
  blastRadius 0
  blastLength 0
  position 0 0 0.95
  orientation 0 0 0 0
  colorStart 0.33 0 0
  colorEnd 0.33 0 0
  alphaStart 1
  alphaEnd 0
  sizeStart 0.02
  sizeEnd 0.8
  sizeStart_y 0
  sizeEnd_y 0
  frameStart 0
  frameEnd 3
  birthrate 2
  lifeExp 6
  mass 2.4
  spread 1.2
  particleRot 0
  velocity 0.6
  randvel 0.6
  fps 0
  xsize 12
  ysize 12
  bounce_co 0
  blurlength 0.1
  lightningDelay 0
  lightningRadius 0
  lightningScale 0
  p2p_bezier2 0
  p2p_bezier3 0
  combinetime 0
  drag 0
  grav 0
  threshold 0
endnode
endmodelgeom n5_bleed

newanim impact n5_bleed
  length 0.2
  transtime 0.25
  animroot n5_bleed
node dummy n5_bleed
  parent NULL
endnode
node emitter n5_bleed_puddle
  parent n5_bleed
endnode
doneanim impact n5_bleed

newanim duration n5_bleed
  length 2
  transtime 0.25
  animroot n5_bleed
node dummy n5_bleed
  parent NULL
endnode
node emitter n5_bleed_puddle
  parent n5_bleed
endnode
doneanim duration n5_bleed

newanim cessation n5_bleed
  length 1
  transtime 0.25
  animroot n5_bleed
node dummy n5_bleed
  parent NULL
endnode
node emitter n5_bleed_puddle
  parent n5_bleed
  birthratekey 1
    0 0
endnode
doneanim cessation n5_bleed

donemodel n5_bleed

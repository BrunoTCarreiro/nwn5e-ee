#MAXMODEL ASCII
# nwn5e (#39, Prestidigitation's Magic Mark, green): a 0.5 m mark standing on a door or a placeable - the owner's symbol n5t_mark02.
newmodel n5v_mark02nu
setsupermodel n5v_mark02nu NULL
classification effect
setanimationscale 1
beginmodelgeom n5v_mark02nu
node dummy n5v_mark02nu
  parent NULL
endnode
node trimesh n5v_mark02nu_mark
  parent n5v_mark02nu
  ambient 0.35 1.00 0.45
  diffuse 0.35 1.00 0.45
  specular 0 0 0
  shininess 1
  bitmap n5t_mark02
  render 1
  shadow 0
  beaming 0
  inheritcolor 0
  alpha 0.8
  transparencyhint 1
  selfillumcolor 0.35 1.00 0.45
  tilefade 0
  rotatetexture 0
  position 0 0 0
  orientation 0 0 0 0
  verts 4
    0.2500 0.0000 -0.2500
    -0.2500 0.0000 -0.2500
    -0.2500 0.0000 0.2500
    0.2500 0.0000 0.2500
  tverts 4
    0.0000 0.0000 0
    1.0000 0.0000 0
    1.0000 1.0000 0
    0.0000 1.0000 0
  faces 4
    0 1 2 1 0 1 2 0
    0 2 3 1 0 2 3 0
    0 2 1 1 0 2 1 0
    0 3 2 1 0 3 2 0
endnode
endmodelgeom n5v_mark02nu

newanim impact n5v_mark02nu
  length 0.1
  transtime 0.25
  animroot n5v_mark02nu
node dummy n5v_mark02nu
  parent NULL
endnode
doneanim impact n5v_mark02nu

newanim duration n5v_mark02nu
  length 1
  transtime 0.25
  animroot n5v_mark02nu
node dummy n5v_mark02nu
  parent NULL
endnode
doneanim duration n5v_mark02nu

newanim cessation n5v_mark02nu
  length 1.5
  transtime 0.05
  animroot n5v_mark02nu
node dummy n5v_mark02nu
  parent NULL
endnode
node trimesh n5v_mark02nu_mark
  parent n5v_mark02nu
  alphakey 2
    0 0.8
    1.5 0
  scalekey 2
    0 1
    1.5 0.05
endnode
doneanim cessation n5v_mark02nu

donemodel n5v_mark02nu

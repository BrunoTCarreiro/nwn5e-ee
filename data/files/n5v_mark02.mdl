#MAXMODEL ASCII
# nwn5e (#39, Prestidigitation's Magic Mark): a 0.6 m mark on the ground - the owner's symbol n5t_mark02.
newmodel n5v_mark02
setsupermodel n5v_mark02 NULL
classification effect
setanimationscale 1
beginmodelgeom n5v_mark02
node dummy n5v_mark02
  parent NULL
endnode
node trimesh n5v_mark02_mark
  parent n5v_mark02
  ambient 1 1 1
  diffuse 1 1 1
  specular 0 0 0
  shininess 1
  bitmap n5t_mark02
  render 1
  shadow 0
  beaming 0
  inheritcolor 0
  alpha 0.8
  transparencyhint 1
  selfillumcolor 1 1 1
  tilefade 0
  rotatetexture 0
  position 0 0 0.03
  orientation 0 0 0 0
  verts 4
    -0.3000 -0.3000 0.0000
    0.3000 -0.3000 0.0000
    0.3000 0.3000 0.0000
    -0.3000 0.3000 0.0000
  tverts 4
    0.0000 0.0000 0
    1.0000 0.0000 0
    1.0000 1.0000 0
    0.0000 1.0000 0
  faces 2
    0 1 2 1 0 1 2 0
    0 2 3 1 0 2 3 0
endnode
endmodelgeom n5v_mark02

newanim impact n5v_mark02
  length 0.1
  transtime 0.25
  animroot n5v_mark02
node dummy n5v_mark02
  parent NULL
endnode
doneanim impact n5v_mark02

newanim duration n5v_mark02
  length 1
  transtime 0.25
  animroot n5v_mark02
node dummy n5v_mark02
  parent NULL
endnode
doneanim duration n5v_mark02

newanim cessation n5v_mark02
  length 0.5
  transtime 0.05
  animroot n5v_mark02
node dummy n5v_mark02
  parent NULL
endnode
node trimesh n5v_mark02_mark
  parent n5v_mark02
  alphakey 2
    0 0.8
    0.5 0
endnode
doneanim cessation n5v_mark02

donemodel n5v_mark02

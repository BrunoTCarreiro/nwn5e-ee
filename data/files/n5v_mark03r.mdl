#MAXMODEL ASCII
# nwn5e (#39, Prestidigitation's Magic Mark, red): a 0.6 m mark flat on the ground - the owner's symbol n5t_mark03.
newmodel n5v_mark03r
setsupermodel n5v_mark03r NULL
classification effect
setanimationscale 1
beginmodelgeom n5v_mark03r
node dummy n5v_mark03r
  parent NULL
endnode
node trimesh n5v_mark03r_mark
  parent n5v_mark03r
  ambient 1.00 0.28 0.22
  diffuse 1.00 0.28 0.22
  specular 0 0 0
  shininess 1
  bitmap n5t_mark03
  render 1
  shadow 0
  beaming 0
  inheritcolor 0
  alpha 0.8
  transparencyhint 1
  selfillumcolor 1.00 0.28 0.22
  tilefade 0
  rotatetexture 0
  position 0 0 0
  orientation 0 0 0 0
  verts 4
    -0.3000 -0.3000 0.0300
    0.3000 -0.3000 0.0300
    0.3000 0.3000 0.0300
    -0.3000 0.3000 0.0300
  tverts 4
    0.0000 0.0000 0
    1.0000 0.0000 0
    1.0000 1.0000 0
    0.0000 1.0000 0
  faces 2
    0 1 2 1 0 1 2 0
    0 2 3 1 0 2 3 0
endnode
endmodelgeom n5v_mark03r

newanim impact n5v_mark03r
  length 0.1
  transtime 0.25
  animroot n5v_mark03r
node dummy n5v_mark03r
  parent NULL
endnode
doneanim impact n5v_mark03r

newanim duration n5v_mark03r
  length 1
  transtime 0.25
  animroot n5v_mark03r
node dummy n5v_mark03r
  parent NULL
endnode
doneanim duration n5v_mark03r

newanim cessation n5v_mark03r
  length 1.5
  transtime 0.05
  animroot n5v_mark03r
node dummy n5v_mark03r
  parent NULL
endnode
node trimesh n5v_mark03r_mark
  parent n5v_mark03r
  alphakey 2
    0 0.8
    1.5 0
  selfillumcolorkey 2
    0 1.00 0.28 0.22
    1.5 0 0 0
  scalekey 2
    0 1
    1.5 0.5
endnode
doneanim cessation n5v_mark03r

donemodel n5v_mark03r

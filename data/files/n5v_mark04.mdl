#MAXMODEL ASCII
# nwn5e (#39, Prestidigitation's Magic Mark): a 0.6 m mark flat on the ground - the owner's symbol n5t_mark04.
newmodel n5v_mark04
setsupermodel n5v_mark04 NULL
classification effect
setanimationscale 1
beginmodelgeom n5v_mark04
node dummy n5v_mark04
  parent NULL
endnode
node trimesh n5v_mark04_mark
  parent n5v_mark04
  ambient 1 1 1
  diffuse 1 1 1
  specular 0 0 0
  shininess 1
  bitmap n5t_mark04
  render 1
  shadow 0
  beaming 0
  inheritcolor 0
  alpha 0.8
  transparencyhint 1
  selfillumcolor 1 1 1
  tilefade 0
  rotatetexture 0
  position 0 0 0
  orientation 0 0 0 0
  verts 4
    -0.3000 -0.3000 0.0300
    0.3000 -0.3000 0.0300
    0.3000 0.3000 0.0300
    -0.3000 0.3000 0.0300
  tverts 4
    0.0000 0.0000 0
    1.0000 0.0000 0
    1.0000 1.0000 0
    0.0000 1.0000 0
  faces 2
    0 1 2 1 0 1 2 0
    0 2 3 1 0 2 3 0
endnode
endmodelgeom n5v_mark04

newanim impact n5v_mark04
  length 0.1
  transtime 0.25
  animroot n5v_mark04
node dummy n5v_mark04
  parent NULL
endnode
doneanim impact n5v_mark04

newanim duration n5v_mark04
  length 1
  transtime 0.25
  animroot n5v_mark04
node dummy n5v_mark04
  parent NULL
endnode
doneanim duration n5v_mark04

newanim cessation n5v_mark04
  length 1.5
  transtime 0.05
  animroot n5v_mark04
node dummy n5v_mark04
  parent NULL
endnode
node trimesh n5v_mark04_mark
  parent n5v_mark04
  alphakey 2
    0 0.8
    1.5 0
  scalekey 2
    0 1
    1.5 0.05
endnode
doneanim cessation n5v_mark04

donemodel n5v_mark04

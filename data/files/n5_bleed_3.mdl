#MAXMODEL ASCII
# nwn5e (tools/data/bleed_vfx.py): low hit points - a character bleeding;
# the game's textures by name.
newmodel n5_bleed_3
setsupermodel n5_bleed_3 NULL
classification effect
setanimationscale 1
beginmodelgeom n5_bleed_3
node dummy n5_bleed_3
  parent NULL
endnode
